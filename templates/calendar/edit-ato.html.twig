{% extends 'layout.html.twig' %}
{% set libSortable=true %}

{% block title %}{{ parent() }}: ATO - {{ event.title }}{% endblock %}

{% block pageContent %}
    <div class="container container-main pt-3 pb-3 mb-3">
        <div class="bs-component">
            <div class="card mb-3">
                <h3 class="card-header">
                    <i class="fa fa-users"></i> Editer l'ATO - {{ event.title }}
                    <a href="{{ path('calendar_view', {'event': event.id}) }}" class="btn btn-sm btn-secondary float-right">
                        <i class="fa fa-arrow-circle-left"></i> Retour
                    </a>
                </h3>
                <div class="card-body">
                    <div id="ato-editor"
                         data-event-id="{{ event.id }}"
                         data-load-url="{{ path('api_ato_data', {'event': event.id}) }}"
                         data-save-url="{{ path('api_ato_save', {'event': event.id}) }}"
                         data-csrf-token="{{ csrf_token('ato_save') }}"
                         data-view-url="{{ path('calendar_view', {'event': event.id}) }}">
                        <div class="text-center p-5">
                            <i class="fa fa-spinner fa-spin fa-3x"></i>
                            <p class="mt-3">Chargement de l'éditeur ATO...</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock pageContent %}

{% block javascript %}
{{ parent() }}
<script src="/js/ato-editor.js?version={{ app_version }}{% if app.environment == "dev" %}&t={{ "now"|date("YmdHis") }}{% endif %}"></script>
{% endblock %}
