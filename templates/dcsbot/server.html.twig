{% extends 'layout.html.twig' %}

{% block title %}{{ parent() }} - {{ server ? server.name : 'Serveur' }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .password-toggle { cursor: pointer; }
    </style>
{% endblock %}

{% block pageContent %}
    {% if error %}
        <div class="container container-main pt-3 pb-3 mb-3">
            <div class="alert alert-danger" role="alert">
                {{ error }}
            </div>
        </div>
    {% endif %}

    {% if server %}
    <div class="container container-main pt-3 pb-3 mb-3">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('dcsbot_stats') }}">Serveurs DCS</a></li>
                <li class="breadcrumb-item active" aria-current="page">{{ server.name }}</li>
            </ol>
        </nav>

        <h1>
            {{ server.name }}
            {% if server.status == 'Running' %}
                <span class="badge badge-success">{{ server.status }}</span>
            {% elseif server.status == 'Paused' %}
                <span class="badge badge-warning">{{ server.status }}</span>
            {% elseif server.status == 'Shutdown' %}
                <span class="badge badge-secondary">{{ server.status }}</span>
            {% else %}
                <span class="badge badge-info">{{ server.status }}</span>
            {% endif %}
        </h1>

        <div class="row mb-3">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="fa fa-server"></i> Informations serveur</h5>
                    </div>
                    <div class="card-body">
                        <table class="table table-sm mb-0">
                            <tr>
                                <th><i class="fa fa-network-wired"></i> Adresse</th>
                                <td>{{ server.address }}</td>
                            </tr>
                            {% if app.user and app.user.isMember %}
                            <tr>
                                <th><i class="fa fa-key"></i> Mot de passe</th>
                                <td>
                                    {% if server.password %}
                                        <i class="fas fa-eye-slash password-toggle" title="Cliquer pour révéler" onclick="this.classList.toggle('fa-eye-slash'); this.classList.toggle('fa-eye'); var pwd = this.nextElementSibling; pwd.textContent = pwd.textContent === '******' ? pwd.dataset.pwd : '******';"></i>
                                        <span data-pwd="{{ server.password }}">******</span>
                                    {% else %}
                                        -
                                    {% endif %}
                                </td>
                            </tr>
                            {% endif %}
                            {% if server.restartTime %}
                            <tr>
                                <th><i class="fa fa-sync-alt"></i> Prochain redémarrage</th>
                                <td>{{ server.restartTime|date('H:i') }}</td>
                            </tr>
                            {% endif %}
                        </table>
                    </div>
                </div>
            </div>

            {% if server.mission %}
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="fa fa-fighter-jet"></i> Mission en cours</h5>
                    </div>
                    <div class="card-body">
                        <table class="table table-sm mb-0">
                            <tr>
                                <th><i class="fa fa-file-alt"></i> Nom</th>
                                <td>{{ server.mission.name|replace({'_': ' '}) }}</td>
                            </tr>
                            <tr>
                                <th><i class="fa fa-map"></i> Théâtre</th>
                                <td>{{ server.mission.theatre }}</td>
                            </tr>
                            {% if server.mission.dateTime %}
                            <tr>
                                <th><i class="fa fa-sun"></i> Heure mission</th>
                                <td>
                                    {% set sun = sun_state(server.mission.dateTime, server.mission.theatre) %}
                                    <span title="{{ server.mission.dateTime|mission_date }}">
                                        {{ server.mission.dateTime|mission_time }}
                                    </span>
                                    <i class="{{ sun.icon }} ml-2" style="color: {{ sun.color }}" title="{{ sun.tooltip }}"></i>
                                </td>
                            </tr>
                            {% endif %}
                            <tr>
                                <th><i class="fa fa-clock"></i> Uptime</th>
                                <td>{{ (server.mission.uptime / 60)|round }}min</td>
                            </tr>
                            <tr>
                                <th><i class="fa fa-users text-primary"></i> Slots bleus</th>
                                <td>{{ server.mission.blueSlotsUsed ?? 0 }} / {{ server.mission.blueSlots ?? '?' }}</td>
                            </tr>
                            <tr>
                                <th><i class="fa fa-users text-danger"></i> Slots rouges</th>
                                <td>{{ server.mission.redSlotsUsed ?? 0 }} / {{ server.mission.redSlots ?? '?' }}</td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
            {% endif %}
        </div>

        {# Weather #}
        {% if server.weather %}
        <div class="row mb-3">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="fa fa-cloud-sun"></i> Conditions météo</h5>
                    </div>
                    <div class="card-body">
                        <table class="table table-sm mb-0">
                            <tr>
                                <th><i class="fa fa-temperature-high"></i> Température</th>
                                <td>{{ server.weather.temperature|round(1) }} °C</td>
                                <td>{{ ((server.weather.temperature * 9/5) + 32)|round(1) }} °F</td>
                            </tr>
                            <tr>
                                <th><i class="fa fa-tachometer-alt"></i> QNH</th>
                                <td>{{ (server.weather.pressure * 1013.25 / 760)|number_format(0 ,".", " ") }} hPa</td>
                                <td>{{ (server.weather.pressure / 25.4)|number_format(2) }} inHg</td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="fa fa-wind"></i> Vent au sol</h5>
                    </div>
                    <div class="card-body">
                        <table class="table table-sm mb-0">
                            <tr>
                                <th><i class="fa fa-compass"></i> Direction</th>
                                <td colspan="3">{{ ((server.weather.windDirection + 180) % 360)|round(0) }}°</td>
                            </tr>
                            <tr>
                                <th><i class="fa fa-tachometer-alt"></i> Vitesse</th>
                                <td>{{ (server.weather.windSpeed * 1.94384)|round(1) }} kts</td>
                                <td>{{ (server.weather.windSpeed * 3.6)|round(1) }} km/h</td>
                                <td>{{ server.weather.windSpeed|round(0) }} m/s</td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="row mb-3">
            <div class="col-12">
                <div class="alert alert-secondary mb-0">
                    {% set hasWeatherInfo = false %}
                    {% if server.weather.visibility %}
                        <span class="mr-3"><i class="fa fa-eye"></i> Visibilité: {{ (server.weather.visibility / 1000)|round(1) }} km</span>
                        {% set hasWeatherInfo = true %}
                    {% endif %}
                    {% if server.weather.cloudsBase %}
                        <span class="mr-3"><i class="fa fa-cloud"></i> Base nuages: {{ server.weather.cloudsBase }} m</span>
                        {% set hasWeatherInfo = true %}
                    {% endif %}
                    {% if server.weather.cloudsDensity > 0 %}
                        <span class="mr-3">Densité: {{ server.weather.cloudsDensity }}/8</span>
                        {% set hasWeatherInfo = true %}
                    {% endif %}
                    {% if server.weather.precipitation > 0 %}
                        <span class="mr-3"><i class="fa fa-cloud-rain"></i> Précipitations</span>
                        {% set hasWeatherInfo = true %}
                    {% endif %}
                    {% if server.weather.fogEnabled %}
                        <span class="mr-3"><i class="fa fa-smog"></i> Brouillard ({{ server.weather.fogVisibility }} m)</span>
                        {% set hasWeatherInfo = true %}
                    {% endif %}
                    {% if server.weather.dustEnabled %}
                        <span class="mr-3"><i class="fa fa-wind"></i> Poussière ({{ server.weather.dustVisibility }} m)</span>
                        {% set hasWeatherInfo = true %}
                    {% endif %}
                    {% if not hasWeatherInfo %}
                        <span>Conditions standard</span>
                    {% endif %}
                </div>
            </div>
        </div>
        {% endif %}

        {% if server.status == 'Running' and server.players|length > 0 %}
        <div class="row mb-3 ml-1 mr-1">
            <div class="col-12">
                <h2><i class="fa fa-users"></i> Joueurs en ligne ({{ server.players|length }})</h2>
                <div class="table-responsive">
                    <table class="table table-striped table-bordered table-hover">
                        <thead>
                        <tr>
                            <th><i class="fa fa-user"></i> Pseudo</th>
                            <th><i class="fa fa-id-badge"></i> Callsign</th>
                            <th><i class="fa fa-flag"></i> Camp</th>
                            <th><i class="fa fa-plane"></i> Appareil</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for player in server.players %}
                            <tr>
                                <td>{{ player.nick }}</td>
                                <td>{{ player.callsign }}</td>
                                <td>
                                    {% if player.side|lower == 'blue' %}
                                        <span class="badge badge-primary">{{ player.side }}</span>
                                    {% elseif player.side|lower == 'red' %}
                                        <span class="badge badge-danger">{{ player.side }}</span>
                                    {% else %}
                                        <span class="badge badge-secondary">{{ player.side }}</span>
                                    {% endif %}
                                </td>
                                <td>{{ player.unitType }}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        {% endif %}
    </div>

    {% if serverStats %}
    <div class="container container-main pt-3 pb-3 mb-3">
        <div class="row mb-3 ml-1 mr-1">
            <h2><i class="fa fa-chart-bar"></i> Statistiques du serveur</h2>
        </div>
        <div class="row">
            <div class="col-md-3">
                <div class="card text-white bg-primary mb-3">
                    <div class="card-body text-center">
                        <h5 class="card-title"><i class="fa fa-user-friends"></i> Joueurs total</h5>
                        <p class="card-text display-4">{{ serverStats.totalPlayers }}</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-white bg-success mb-3">
                    <div class="card-body text-center">
                        <h5 class="card-title"><i class="fa fa-user-check"></i> Joueurs actifs</h5>
                        <p class="card-text display-4">{{ serverStats.activePlayers }}</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-white bg-info mb-3">
                    <div class="card-body text-center">
                        <h5 class="card-title"><i class="fa fa-plane-departure"></i> Sorties</h5>
                        <p class="card-text display-4">{{ serverStats.totalSorties }}</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-white bg-secondary mb-3">
                    <div class="card-body text-center">
                        <h5 class="card-title"><i class="fa fa-hourglass-half"></i> Temps moyen</h5>
                        <p class="card-text display-4">{{ (serverStats.avgPlaytime / 3600)|round(1) }}h</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-3">
                <div class="card bg-light mb-3">
                    <div class="card-body text-center">
                        <h5 class="card-title"><i class="fa fa-crosshairs"></i> Kills</h5>
                        <p class="card-text h4">{{ serverStats.totalKills }}</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-light mb-3">
                    <div class="card-body text-center">
                        <h5 class="card-title"><i class="fa fa-skull"></i> Deaths</h5>
                        <p class="card-text h4">{{ serverStats.totalDeaths }}</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-light mb-3">
                    <div class="card-body text-center">
                        <h5 class="card-title"><i class="fa fa-crosshairs text-danger"></i> PvP Kills</h5>
                        <p class="card-text h4">{{ serverStats.totalPvPKills }}</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-light mb-3">
                    <div class="card-body text-center">
                        <h5 class="card-title"><i class="fa fa-skull-crossbones text-danger"></i> PvP Deaths</h5>
                        <p class="card-text h4">{{ serverStats.totalPvPDeaths }}</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    {% endif %}

    {# Section Fréquentation #}
    {% if attendance %}
    <div class="container container-main pt-3 pb-3 mb-3">
        <div class="row mb-3 ml-1 mr-1">
            <h2><i class="fa fa-chart-line"></i> Fréquentation du serveur</h2>
        </div>

        {# Cards résumé #}
        <div class="row">
            <div class="col-md-3">
                <div class="card text-white bg-primary mb-3">
                    <div class="card-body text-center">
                        <h5 class="card-title"><i class="fa fa-user-clock"></i> Joueurs actuels</h5>
                        <p class="card-text display-4">{{ attendance.currentPlayers }}</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-white bg-success mb-3">
                    <div class="card-body text-center">
                        <h5 class="card-title"><i class="fa fa-calendar-day"></i> Uniques 24h</h5>
                        <p class="card-text display-4">{{ attendance.uniquePlayers24h }}</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-white bg-info mb-3">
                    <div class="card-body text-center">
                        <h5 class="card-title"><i class="fa fa-calendar-week"></i> Uniques 7j</h5>
                        <p class="card-text display-4">{{ attendance.uniquePlayers7d }}</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-white bg-secondary mb-3">
                    <div class="card-body text-center">
                        <h5 class="card-title"><i class="fa fa-calendar-alt"></i> Uniques 30j</h5>
                        <p class="card-text display-4">{{ attendance.uniquePlayers30d }}</p>
                    </div>
                </div>
            </div>
        </div>

        {# Tableau comparatif périodes #}
        <div class="row mb-3">
            <div class="col-12">
                <div class="table-responsive">
                    <table class="table table-striped table-bordered">
                        <thead>
                            <tr>
                                <th><i class="fa fa-calendar"></i> Période</th>
                                <th><i class="fa fa-user"></i> Joueurs uniques</th>
                                <th><i class="fa fa-clock"></i> Temps de jeu total</th>
                                <th><i class="fab fa-discord"></i> Membres Discord</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>24 heures</td>
                                <td>{{ attendance.uniquePlayers24h }}</td>
                                <td>{{ attendance.totalPlaytimeHours24h|round(1) }}h</td>
                                <td>{{ attendance.discordMembers24h }}</td>
                            </tr>
                            <tr>
                                <td>7 jours</td>
                                <td>{{ attendance.uniquePlayers7d }}</td>
                                <td>{{ attendance.totalPlaytimeHours7d|round(1) }}h</td>
                                <td>{{ attendance.discordMembers7d }}</td>
                            </tr>
                            <tr>
                                <td>30 jours</td>
                                <td>{{ attendance.uniquePlayers30d }}</td>
                                <td>{{ attendance.totalPlaytimeHours30d|round(1) }}h</td>
                                <td>{{ attendance.discordMembers30d }}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        {# Stats combat si disponibles #}
        {% if attendance.totalSorties is not null %}
        <div class="row">
            <div class="col-md-2">
                <div class="card bg-light mb-3">
                    <div class="card-body text-center">
                        <h6 class="card-title"><i class="fa fa-plane-departure"></i> Sorties</h6>
                        <p class="card-text h5">{{ attendance.totalSorties }}</p>
                    </div>
                </div>
            </div>
            {% if attendance.totalKills is not null %}
            <div class="col-md-2">
                <div class="card bg-light mb-3">
                    <div class="card-body text-center">
                        <h6 class="card-title"><i class="fa fa-crosshairs"></i> Kills</h6>
                        <p class="card-text h5">{{ attendance.totalKills }}</p>
                    </div>
                </div>
            </div>
            {% endif %}
            {% if attendance.totalDeaths is not null %}
            <div class="col-md-2">
                <div class="card bg-light mb-3">
                    <div class="card-body text-center">
                        <h6 class="card-title"><i class="fa fa-skull"></i> Deaths</h6>
                        <p class="card-text h5">{{ attendance.totalDeaths }}</p>
                    </div>
                </div>
            </div>
            {% endif %}
            {% if attendance.totalPvpKills is not null %}
            <div class="col-md-3">
                <div class="card bg-light mb-3">
                    <div class="card-body text-center">
                        <h6 class="card-title"><i class="fa fa-crosshairs text-danger"></i> PvP Kills</h6>
                        <p class="card-text h5">{{ attendance.totalPvpKills }}</p>
                    </div>
                </div>
            </div>
            {% endif %}
            {% if attendance.totalPvpDeaths is not null %}
            <div class="col-md-3">
                <div class="card bg-light mb-3">
                    <div class="card-body text-center">
                        <h6 class="card-title"><i class="fa fa-skull-crossbones text-danger"></i> PvP Deaths</h6>
                        <p class="card-text h5">{{ attendance.totalPvpDeaths }}</p>
                    </div>
                </div>
            </div>
            {% endif %}
        </div>
        {% endif %}

        {# Top listes #}
        <div class="row">
            {% if attendance.topTheatres and attendance.topTheatres|length > 0 %}
            <div class="col-md-4">
                <div class="card mb-3">
                    <div class="card-header">
                        <h6 class="mb-0"><i class="fa fa-globe-europe"></i> Top Théâtres</h6>
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-sm mb-0">
                            <tbody>
                            {% for theatre in attendance.topTheatres %}
                                <tr>
                                    <td>{{ theatre.theatre }}</td>
                                    <td class="text-right">{{ theatre.playtimeHours|round(1) }}h</td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            {% endif %}

            {% if attendance.topMissions and attendance.topMissions|length > 0 %}
            <div class="col-md-4">
                <div class="card mb-3">
                    <div class="card-header">
                        <h6 class="mb-0"><i class="fa fa-tasks"></i> Top Missions</h6>
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-sm mb-0">
                            <tbody>
                            {% for mission in attendance.topMissions %}
                                <tr>
                                    <td>{{ mission.missionName|replace({'_': ' '}) }}</td>
                                    <td class="text-right">{{ mission.playtimeHours|round(1) }}h</td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            {% endif %}

            {% if attendance.topModules and attendance.topModules|length > 0 %}
            <div class="col-md-4">
                <div class="card mb-3">
                    <div class="card-header">
                        <h6 class="mb-0"><i class="fa fa-fighter-jet"></i> Top Modules</h6>
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-sm mb-0">
                            <tbody>
                            {% for module in attendance.topModules %}
                                <tr>
                                    <td>{{ module.module|replace({'_': ' '}) }}</td>
                                    <td class="text-right">{{ module.playtimeHours|round(1) }}h</td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            {% endif %}
        </div>
    </div>
    {% endif %}
    {% endif %}

{% endblock pageContent %}
