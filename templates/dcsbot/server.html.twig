{% extends 'layout.html.twig' %}

{% block title %}{{ parent() }} - {{ server ? server.name : 'Serveur' }}{% endblock %}

{% block pageContent %}
    {% if error %}
        <div class="container container-main pt-3 pb-3 mb-3">
            <div class="alert alert-danger" role="alert">
                {{ error }}
            </div>
        </div>
    {% endif %}

    {% if server %}
    <div class="container container-main pt-3 pb-3 mb-3">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('dcsbot_stats') }}">Serveurs DCS</a></li>
                <li class="breadcrumb-item active" aria-current="page">{{ server.name }}</li>
            </ol>
        </nav>

        <h1>
            {{ server.name }}
            {% if server.status == 'Running' %}
                <span class="badge badge-success">{{ server.status }}</span>
            {% elseif server.status == 'Paused' %}
                <span class="badge badge-warning">{{ server.status }}</span>
            {% elseif server.status == 'Shutdown' %}
                <span class="badge badge-secondary">{{ server.status }}</span>
            {% else %}
                <span class="badge badge-info">{{ server.status }}</span>
            {% endif %}
        </h1>

        <div class="row mb-3">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">Informations serveur</h5>
                    </div>
                    <div class="card-body">
                        <table class="table table-sm mb-0">
                            <tr>
                                <th>Adresse</th>
                                <td>{{ server.address }}</td>
                            </tr>
                            {% if app.user and app.user.isMember %}
                            <tr>
                                <th>Mot de passe</th>
                                <td>{{ server.password ? server.password : '-' }}</td>
                            </tr>
                            {% endif %}
                            {% if server.restartTime %}
                            <tr>
                                <th>Prochain redémarrage</th>
                                <td>{{ server.restartTime|date('H:i') }}</td>
                            </tr>
                            {% endif %}
                        </table>
                    </div>
                </div>
            </div>

            {% if server.mission %}
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">Mission en cours</h5>
                    </div>
                    <div class="card-body">
                        <table class="table table-sm mb-0">
                            <tr>
                                <th>Nom</th>
                                <td>{{ server.mission.name }}</td>
                            </tr>
                            <tr>
                                <th>Theatre</th>
                                <td>{{ server.mission.theatre }}</td>
                            </tr>
                            <tr>
                                <th>Uptime</th>
                                <td>{{ (server.mission.uptime / 60)|round }}min</td>
                            </tr>
                            <tr>
                                <th>Slots bleus</th>
                                <td>{{ server.mission.blueSlotsUsed ?? 0 }} / {{ server.mission.blueSlots ?? '?' }}</td>
                            </tr>
                            <tr>
                                <th>Slots rouges</th>
                                <td>{{ server.mission.redSlotsUsed ?? 0 }} / {{ server.mission.redSlots ?? '?' }}</td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
            {% endif %}
        </div>

        {% if server.players and server.players|length > 0 %}
        <div class="row mb-3 ml-1 mr-1">
            <div class="col-12">
                <h2>Joueurs en ligne ({{ server.players|length }})</h2>
                <div class="table-responsive">
                    <table class="table table-striped table-bordered table-hover">
                        <thead>
                        <tr>
                            <th>Pseudo</th>
                            <th>Callsign</th>
                            <th>Camp</th>
                            <th>Appareil</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for player in server.players %}
                            <tr>
                                <td>{{ player.nick }}</td>
                                <td>{{ player.callsign }}</td>
                                <td>
                                    {% if player.side|lower == 'blue' %}
                                        <span class="badge badge-primary">{{ player.side }}</span>
                                    {% elseif player.side|lower == 'red' %}
                                        <span class="badge badge-danger">{{ player.side }}</span>
                                    {% else %}
                                        <span class="badge badge-secondary">{{ player.side }}</span>
                                    {% endif %}
                                </td>
                                <td>{{ player.unitType }}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        {% endif %}
    </div>

    {% if serverStats %}
    <div class="container container-main pt-3 pb-3 mb-3">
        <div class="row mb-3 ml-1 mr-1">
            <h2>Statistiques du serveur</h2>
        </div>
        <div class="row">
            <div class="col-md-3">
                <div class="card text-white bg-primary mb-3">
                    <div class="card-body text-center">
                        <h5 class="card-title">Joueurs total</h5>
                        <p class="card-text display-4">{{ serverStats.totalPlayers }}</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-white bg-success mb-3">
                    <div class="card-body text-center">
                        <h5 class="card-title">Joueurs actifs</h5>
                        <p class="card-text display-4">{{ serverStats.activePlayers }}</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-white bg-info mb-3">
                    <div class="card-body text-center">
                        <h5 class="card-title">Sorties</h5>
                        <p class="card-text display-4">{{ serverStats.totalSorties }}</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-white bg-secondary mb-3">
                    <div class="card-body text-center">
                        <h5 class="card-title">Temps moyen</h5>
                        <p class="card-text display-4">{{ (serverStats.avgPlaytime / 3600)|round }}h</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-3">
                <div class="card bg-light mb-3">
                    <div class="card-body text-center">
                        <h5 class="card-title">Kills</h5>
                        <p class="card-text h4">{{ serverStats.totalKills }}</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-light mb-3">
                    <div class="card-body text-center">
                        <h5 class="card-title">Deaths</h5>
                        <p class="card-text h4">{{ serverStats.totalDeaths }}</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-light mb-3">
                    <div class="card-body text-center">
                        <h5 class="card-title">PvP Kills</h5>
                        <p class="card-text h4">{{ serverStats.totalPvPKills }}</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-light mb-3">
                    <div class="card-body text-center">
                        <h5 class="card-title">PvP Deaths</h5>
                        <p class="card-text h4">{{ serverStats.totalPvPDeaths }}</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    {% endif %}
    {% endif %}

{% endblock pageContent %}
