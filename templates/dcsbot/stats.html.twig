{% extends 'layout.html.twig' %}

{% block title %}{{ parent() }} - Serveurs DCS{% endblock %}

{% block pageContent %}
    {% if error %}
        <div class="container container-main pt-3 pb-3 mb-3">
            <div class="alert alert-danger" role="alert">
                {{ error }}
            </div>
        </div>
    {% endif %}

    <div class="container container-main pt-3 pb-3 mb-3">
        <div class="row mb-3 ml-1 mr-1">
            <h1><i class="fas fa-server mr-2"></i>Liste des serveurs</h1>
            <div class="table-responsive">
                <table class="table table-striped table-bordered table-hover">
                    <thead>
                    <tr>
                        <th><i class="fas fa-hdd mr-1"></i> Serveur</th>
                        <th><i class="fas fa-power-off mr-1"></i> Status</th>
                        <th><i class="fas fa-globe mr-1"></i> Theatre</th>
                        <th><i class="fas fa-fighter-jet mr-1"></i> Mission</th>
                        <th><i class="fas fa-users mr-1"></i> Joueurs</th>
                        <th><i class="fas fa-clock mr-1"></i> Uptime</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for server in servers %}
                        <tr>
                            <td><a href="{{ path('dcsbot_server', {serverName: server.name}) }}">{{ server.name|split('-', 2)|last }}</a></td>
                            <td>
                                {% if server.status == 'Running' %}
                                    <span class="badge badge-success"><i class="fas fa-play mr-1"></i>{{ server.status }}</span>
                                {% elseif server.status == 'Paused' %}
                                    <span class="badge badge-warning"><i class="fas fa-pause mr-1"></i>{{ server.status }}</span>
                                {% elseif server.status == 'Shutdown' %}
                                    <span class="badge badge-secondary"><i class="fas fa-stop mr-1"></i>{{ server.status }}</span>
                                {% else %}
                                    <span class="badge badge-info"><i class="fas fa-question mr-1"></i>{{ server.status }}</span>
                                {% endif %}
                            </td>
                            <td>{{ server.mission ? server.mission.theatre : '-' }}</td>
                            <td>{{ server.mission ? server.mission.name : '-' }}</td>
                            <td>
                                {% if server.players %}
                                    {{ server.players|length }}
                                {% else %}
                                    0
                                {% endif %}
                            </td>
                            <td>
                                {% if server.mission %}
                                    {{ (server.mission.uptime / 60)|round }}min
                                {% else %}
                                    -
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6">
                                <i>Pas de serveurs disponibles</i>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    {% if serverStats %}
    <div class="container container-main pt-3 pb-3 mb-3">
        <div class="row mb-3 ml-1 mr-1">
            <h2><i class="fas fa-chart-bar mr-2"></i>Statistiques globales</h2>
        </div>
        <div class="row">
            <div class="col-md-3">
                <div class="card text-white bg-primary mb-3">
                    <div class="card-body text-center">
                        <h5 class="card-title"><i class="fas fa-users mr-1"></i> Joueurs total</h5>
                        <p class="card-text display-4">{{ serverStats.totalPlayers }}</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-white bg-success mb-3">
                    <div class="card-body text-center">
                        <h5 class="card-title"><i class="fas fa-user-check mr-1"></i> Joueurs actifs</h5>
                        <p class="card-text display-4">{{ serverStats.activePlayers }}</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-white bg-info mb-3">
                    <div class="card-body text-center">
                        <h5 class="card-title"><i class="fas fa-plane-departure mr-1"></i> Sorties</h5>
                        <p class="card-text display-4">{{ serverStats.totalSorties }}</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-white bg-secondary mb-3">
                    <div class="card-body text-center">
                        <h5 class="card-title"><i class="fas fa-hourglass-half mr-1"></i> Temps moyen</h5>
                        <p class="card-text display-4">{{ (serverStats.avgPlaytime / 3600)|round }}h</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-3">
                <div class="card bg-light mb-3">
                    <div class="card-body text-center">
                        <h5 class="card-title"><i class="fas fa-crosshairs mr-1"></i> Kills</h5>
                        <p class="card-text h4">{{ serverStats.totalKills }}</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-light mb-3">
                    <div class="card-body text-center">
                        <h5 class="card-title"><i class="fas fa-skull mr-1"></i> Deaths</h5>
                        <p class="card-text h4">{{ serverStats.totalDeaths }}</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-light mb-3">
                    <div class="card-body text-center">
                        <h5 class="card-title"><i class="fas fa-crosshairs mr-1"></i> PvP Kills</h5>
                        <p class="card-text h4">{{ serverStats.totalPvPKills }}</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-light mb-3">
                    <div class="card-body text-center">
                        <h5 class="card-title"><i class="fas fa-skull-crossbones mr-1"></i> PvP Deaths</h5>
                        <p class="card-text h4">{{ serverStats.totalPvPDeaths }}</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    {% endif %}

{% endblock pageContent %}
